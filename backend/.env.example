# ==========================================
# VIRALCLIP AI - CLOUD BACKEND CONFIGURATION
# ==========================================

# Port pro FastAPI server (Railway a Render dosazují $PORT automaticky)
PORT=8000

# Povolené domény pro CORS (Frontend URL na Vercelu nebo localhost)
ALLOWED_ORIGINS=http://localhost:3000,https://*.vercel.app

# OpenAI API Key (pro Whisper Audio Transkripci a GPT-4o Virality Scoring)
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ElevenLabs API Key (pro generování realistického komentáře v Režimu 2)
ELEVENLABS_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Výchozí ID hlasu v ElevenLabs (např. Adam = pNInz6obpgDQGcFmaJgB, Rachel = 21m00Tcm4TlvDq8ikWAM)
DEFAULT_ELEVENLABS_VOICE_ID=pNInz6obpgDQGcFmaJgB

# Adresář pro dočasné soubory a výstupy
TEMP_DIR=/app/temp
OUTPUTS_DIR=/app/outputs

# Maximální počet vygenerovaných klipů na jedno video
MAX_CLIPS_PER_VIDEO=3

# Minimální skóre virality pro zařazení do střihu (škála 1-10)
MIN_VIRALITY_SCORE=8.0

